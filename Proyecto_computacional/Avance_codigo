import numpy as np
import scipy.sparse as sp
import scipy.sparse.linalg as spla
from scipy.interpolate import griddata
import matplotlib.pyplot as plt
import matplotlib.animation as animation
from matplotlib.cm import ScalarMappable
from matplotlib.colors import Normalize

# ------------------- Geometria -------------------

D = 0.02  # Diametro promedio de la aorta abdonminal en [m]
# Parametros para la geometria
L1 = 2.5 * D
L2 = 5 * D
D2 = 2.75 * D
Lt = 11.25 * D
D1 = 2 * D

#Dominio físico del aneurisma 
def radio_aorta(x_val):
    if 0 <= x_val <= L1:
        return D / 2
    elif L1 <= x_val <= L1 + L2: # Parte del aneurisma
        aneurisma = (((D2 - D) / 4) * (1 + np.sin(((2 * np.pi * (x_val - L1)) / L2) - (np.pi / 2)))) + D / 2
        return aneurisma
    else:
        return D / 2


# ------------------- Mapeo de Coordenadas -------------------


nx, ny = 100, 30 # División del dominio

# Creamos una lista equiespaciada 
x = np.linspace(0, Lt, nx) # Abarca la longitud
xi = np.linspace(-1, 1, ny) # Coordenada normalizada de -1 a 1

dx = x[1] - x[0] # 2.27 mm
dxi = xi[1] - xi[0] # 68.9 mm

#Creamos dos listas vacias
X = np.zeros((ny, nx)) # Posición horizontal de cada nodo 
Y = np.zeros((ny, nx)) # Posición vertical de cada nodo 

# Generamos la malla física
for i in range(nx): # Avanzamos a lo largo de la arteria, columna por columna
    R_local = radio_aorta(x[i]) # Nos dice el radio exacto en i  R(x)
    for j in range(ny):
        X[j, i] = x[i] # Todos los puntos de una misma columna comparten la misma posición horizontal.
        Y[j, i] = xi[j] * R_local # Multiplicamos xi por R. La malla se estira verticalmente dentro del aneurisma y se contrae en las zonas rectas

# ------------------- Mapeo de Derivadas -------------------

R_limite = np.array([radio_aorta(val) for val in x]) # Arreglo (1D) que contiene el radio de la arteria R(x) en cada punto longitudinal
dRdx = np.gradient(R_limite, dx)
inv_R = 1.0 / R_limite[None, :]
term_corr = - (xi[:, None] * dRdx) / R_limite

# ------------------- Parametros de Carreau -------------------

mu_0 = 0.056
mu_inf = 0.00345
delta = 3.313
n = 0.3568
a = 2
rho = 1050

#Calculo de la viscocidad dinámica de la sangre en cada punto del dominio
def calcular_viscosidad(u, v, inv_R, term_corr, dx, dxi):
    # Calulamos las derivadas espaciales de las velocidades u y v con respecto
    # a la malla computacional normalizada. np.gradiente utiliza discretización de diferencias finitas centradas
    ui_xi = np.gradient(u, dxi, axis=0)
    
    uj_xi = np.gradient(v, dxi, axis=0)
    ui_j_matriz = np.gradient(u, dx, axis=1)
    uj_i_matriz = np.gradient(v, dx, axis=1)

    # Utilizando la regla de la cadena transformamos las derivadas "rectangulares" a las derivadas físicas reales
    du_dy = ui_xi * inv_R
    dv_dy = uj_xi * inv_R

    du_dx = ui_j_matriz + term_corr * ui_xi
    dv_dx = uj_i_matriz + uj_xi * term_corr
    
    # Componentes del tensor de tasa de deformación
    # Este tensor mide cómo las capas de fluido se estiran y se deslizan unas sobre otras
    Dxx = du_dx
    Dyy = dv_dy
    Dxy = 0.5 * (du_dy + dv_dx)
    
    # Calculamos la magnitud de la tasa de Corte
    gamma_dot = np.sqrt(2 * (Dxx**2 + Dyy**2 + 2 * Dxy**2))
    gamma_dot = np.clip(gamma_dot, 1e-7, 1e5) #Define los limites de la tasa de corte
    mu_gamma = (((1 + (delta * gamma_dot)**a)**((n - 1) / a)) * (mu_0 - mu_inf)) + mu_inf # Calculamos segun el modelo de Carreau
    return mu_gamma


def construir_operador_2da_derivada(N, h):
    # Construimos un esquema compacto (tipo Padé) para la segunda derivada. 
    # El esquema tiene la forma implicita: LHS⋅f′′= RHS⋅f
    
    
    # N es el número de puntos de la malla
    # h es el espaciado
    J = N - 1 # índice del último punto
    h2 = h * h

    # Coeficientes interiores para p=3,4,..J-3
    al, be, ga = 0.63739437, 0.14766675, 0.00682344
    a16, b16, c16 = -0.09172399, 1.70280915, 0.97268396
    
    # Coeficientes esquema 4to orden para p=2 y p=J-2
    al_t, be_t = 0.40437617, 0.02221463
    a17, b17 = 0.49797006, 1.35521152
    
    # Las matrices N x N inicializadas a cero 
    LHS = np.zeros((N, N))
    RHS = np.zeros((N, N))

    # --- Bordes p=0 y p=J : 2da derivada lateral de 2do orden ---
    LHS[0, 0] = 1.0 # Establecemos que el coeficiente de f''_0 es 1
    RHS[0, 0], RHS[0, 1], RHS[0, 2], RHS[0, 3] = 2.0 / h2, -5.0 / h2, 4.0 / h2, -1.0 / h2 # Esquema asimétrico "hacia adelante" (FD). Evalúa los puntos 0, 1, 2 y 3 de la derecha para calcular la segunda derivada en la pared izquierda.
    LHS[J, J] = 1.0 # Hace lo mismo pero en la pared derecha. Pero apunta hacia atras (BD)
    RHS[J, J], RHS[J, J - 1], RHS[J, J - 2], RHS[J, J - 3] = 2.0 / h2, -5.0 / h2, 4.0 / h2, -1.0 / h2

    # --- p=1 y p=J-1 : Pade clasico ---
    # Utilizamos el esquema compacto tridiagonal clásico de cuarto orden
    for p in (1, J - 1):
        LHS[p, p - 1], LHS[p, p], LHS[p, p + 1] = 1.0 / 10, 1.0, 1.0 / 10
        RHS[p, p - 1], RHS[p, p], RHS[p, p + 1] = 1.2 / h2, -2.4 / h2, 1.2 / h2

    # --- p=2 y p=J-2 : esquema 4to orden ---
    # Esquema pentadiagonal.
    for p in (2, J - 2):
        LHS[p, p - 2], LHS[p, p - 1], LHS[p, p], LHS[p, p + 1], LHS[p, p + 2] = be_t, al_t, 1.0, al_t, be_t
        RHS[p, p - 2] = b17 / (4 * h2)
        RHS[p, p - 1] = a17 / h2
        RHS[p, p] = -2 * b17 / (4 * h2) - 2 * a17 / h2
        RHS[p, p + 1] = a17 / h2
        RHS[p, p + 2] = b17 / (4 * h2)

    # --- p=3 ... J-3 : esquema compacto ---
    # Esquema heptadiagonal
    for p in range(3, J - 2):
        LHS[p, p - 3], LHS[p, p - 2], LHS[p, p - 1] = ga, be, al
        LHS[p, p] = 1.0
        LHS[p, p + 1], LHS[p, p + 2], LHS[p, p + 3] = al, be, ga
        RHS[p, p - 3] = c16 / (9 * h2)
        RHS[p, p - 2] = b16 / (4 * h2)
        RHS[p, p - 1] = a16 / h2
        RHS[p, p] = -2 * c16 / (9 * h2) - 2 * b16 / (4 * h2) - 2 * a16 / h2
        RHS[p, p + 1] = a16 / h2
        RHS[p, p + 2] = b16 / (4 * h2)
        RHS[p, p + 3] = c16 / (9 * h2)
        
        # np.linalg.solve() utiliza una libreria llamada LAPACK. Utiliza el metodo de descomposicion LU. A=LU y resuleve el sistema
    return np.linalg.solve(LHS, RHS) # El return es f′′= Df


# Operadores de 2da derivada. Al aplicarlos sobre f, calcula la segunda derivada
M_x = construir_operador_2da_derivada(nx, dx)    # Construye el operador de segunda derivada para la dirección x.  El resultado M_x es una matriz nx × nx.
M_xi = construir_operador_2da_derivada(ny, dxi)   # Lo mismo que el anteriorperov para la dirección xi


# ------------------- Operador de 1ra derivada compacta Pade 6to orden -------------------
# Esquema centrado de alto orden para la adveccion
# Forma implicita: LHS * f' = RHS * f
def construir_operador_1ra_derivada(N, h):
    # N es el numero de puntos de la malla; h es el espaciado
    LHS = np.zeros((N, N))
    RHS = np.zeros((N, N))

    # --- Interior (i = 2 ... N-3): Pade 6to orden ---
    for i in range(2, N - 2):
        LHS[i, i - 1] = 1.0 / 3.0
        LHS[i, i]     = 1.0
        LHS[i, i + 1] = 1.0 / 3.0
        RHS[i, i - 1] = -14.0 / (9.0 * 2.0 * h)
        RHS[i, i + 1] =  14.0 / (9.0 * 2.0 * h)
        RHS[i, i - 2] =  -1.0 / (9.0 * 4.0 * h)
        RHS[i, i + 2] =   1.0 / (9.0 * 4.0 * h)

    # --- p=1 y p=N-2: Pade clasico 4to orden (tridiagonal) ---
    for i in (1, N - 2):
        LHS[i, i - 1] = 1.0 / 4.0
        LHS[i, i]     = 1.0
        LHS[i, i + 1] = 1.0 / 4.0
        RHS[i, i - 1] = -3.0 / (4.0 * h)
        RHS[i, i + 1] =  3.0 / (4.0 * h)

    # --- Borde i=0: esquema asimetrico forward 3er orden ---
    LHS[0, 0] = 1.0
    LHS[0, 1] = 2.0
    RHS[0, 0] = -5.0 / (2.0 * h)
    RHS[0, 1] =  2.0 / h
    RHS[0, 2] =  1.0 / (2.0 * h)

    # --- Borde i=N-1: esquema asimetrico backward 3er orden ---
    LHS[N - 1, N - 1] = 1.0
    LHS[N - 1, N - 2] = 2.0
    RHS[N - 1, N - 1] =  5.0 / (2.0 * h)
    RHS[N - 1, N - 2] = -2.0 / h
    RHS[N - 1, N - 3] = -1.0 / (2.0 * h)

    return np.linalg.solve(LHS, RHS)


# Operadores de 1ra derivada (analogos a M_x, M_xi pero para primera derivada)
D_x  = construir_operador_1ra_derivada(nx, dx)   # df/dx_m
D_xi = construir_operador_1ra_derivada(ny, dxi)  # df/dxi

#Definimos las siguientes funciones para que calculen la primera derivada de un campo 2D f a traves de cada eje
def d_dx_compacta(f):    # df/dx_m  (sobre eje x, columnas)
    return f @ D_x.T
# Para aplicar la derivada a las columnas (eje x) multiplicamos f por la transpuesta de M_x

def d_dxi_compacta(f):   # df/dxi  (sobre eje xi, filas)
    return D_xi @ f

#Definimos las siguientes funciones para que calculen la segunda derivada de un campo 2D f a traves de cada eje
def d2_dx2_compacta(f):    # d2f/dx_m^2  (sobre eje x)
    return f @ M_x.T


def d2_dxi2_compacta(f):   # d2f/dxi^2  (sobre eje xi)
    return M_xi @ f # Aplicamos la derivada sobre las filas (eje xi)



# ------------------- Filtro compacto Pade 6to orden (Lele 1992, Visbal & Gaitonde 2002) -------------------
def construir_filtro_padre(N, alpha_f=0.49):
    # alpha_f en [0, 0.5]. Cuanto mas cerca de 0.5, mas selectivo es el filtro (toca menos los modos fisicos)
    a0 = (11.0 + 10.0 * alpha_f) / 16.0
    a1 = (15.0 + 34.0 * alpha_f) / 32.0
    a2 = (-3.0 +  6.0 * alpha_f) / 16.0
    a3 = ( 1.0 -  2.0 * alpha_f) / 32.0
    LHS = np.eye(N)
    RHS = np.eye(N)
    # Los 3 puntos de cada borde no se filtran (RHS = identidad), evita perturbar las CB
    for i in range(3, N - 3):
        LHS[i, i - 1] = alpha_f
        LHS[i, i]     = 1.0
        LHS[i, i + 1] = alpha_f
        RHS[i, i]     = a0
        RHS[i, i - 1] = a1 / 2.0; RHS[i, i + 1] = a1 / 2.0
        RHS[i, i - 2] = a2 / 2.0; RHS[i, i + 2] = a2 / 2.0
        RHS[i, i - 3] = a3 / 2.0; RHS[i, i + 3] = a3 / 2.0
    return np.linalg.solve(LHS, RHS)


# Construye los operadores de filtro en cada direccion una sola vez
F_x  = construir_filtro_padre(nx, alpha_f=0.49)
F_xi = construir_filtro_padre(ny, alpha_f=0.49)

def aplicar_filtro_padre(f):
    # Filtra en ambos ejes: primero en xi (filas), luego en x (columnas)
    return F_xi @ (f @ F_x.T)


# ------------------- Velocidad intermedia (Chorin) -------------------
def velocidad_intermedia(u, v, mu, dt, rho, dx, dxi, inv_R, term_corr):
    # Velocidades contravariantes:
    #   u d/dx_fis + v d/dy_fis = u d/dx_m + (u*term_corr + v*inv_R) d/dxi
    U_cx = u
    U_cxi = u * term_corr + v * inv_R

    # ---- Adveccion:   ----
    adv_u = U_cx * d_dx_compacta(u) + U_cxi * d_dxi_compacta(u)
    adv_v = U_cx * d_dx_compacta(v) + U_cxi * d_dxi_compacta(v)

    # ---- Difusion: Laplaciano con 2da derivada  ----
    # d2/dy^2 = inv_R^2 * d2/dxi^2  (exacto por el mapeo y = xi*R(x))
    d2u_dy2 = inv_R**2 * d2_dxi2_compacta(u)
    d2v_dy2 = inv_R**2 * d2_dxi2_compacta(v)


    du_dx_m = np.gradient(u, dx, axis=1)
    dv_dx_m = np.gradient(v, dx, axis=1)
    d2u_dx2 = d2_dx2_compacta(u) + term_corr * np.gradient(du_dx_m, dxi, axis=0)
    d2v_dx2 = d2_dx2_compacta(v) + term_corr * np.gradient(dv_dx_m, dxi, axis=0)

    dif_u = mu * (d2u_dx2 + d2u_dy2) / rho
    dif_v = mu * (d2v_dx2 + d2v_dy2) / rho

    u_star = u + dt * (-adv_u + dif_u)
    v_star = v + dt * (-adv_v + dif_v)

    u_star[0, :], u_star[-1, :] = 0, 0
    v_star[0, :], v_star[-1, :] = 0, 0
    return u_star, v_star


# ------------------- Poisson DIRECTO con Laplaciano compacto -------------------
# Se ensambla L (Laplaciano discreto) usando las 2da derivadas compactas con sus condiciones de borde
# y devuelve su factorización LU
def construir_sistema_poisson(M_x, M_xi, inv_R):
    
    I_ny = sp.identity(ny, format='csr')   # Matriz identidad de tamaño ny en formato CSR
    I_nx = sp.identity(nx, format='csr')   # Matriz identidad de tamaño nx en CSR
    
    
    # Necesitamos aplanar en un solo vector 1D la malla 2D. El prodcuto kronecker toma los operadores
    # de derivadas 1D y los expandimos a las dimensiones correctas para operar sobre la malla aplanada.
    A_xx = sp.kron(I_ny, sp.csr_matrix(M_x))                  # d2/dx_m^2
    A_xixi = sp.kron(sp.csr_matrix(M_xi), I_nx)               # d2/dxi^2
    D_mat = sp.diags(np.tile((inv_R.ravel())**2, ny))         # Matriz diagonal con 1/R^2(x)
    L = (A_xx + D_mat @ A_xixi).tolil()                       # Suma las derivadas horizontales y verticales para formar el Laplaciano físico total.
    # .tolil() convierte la matriz a un formato de lista para poder modificar sus filas rápidamente en el siguiente paso.
    
    def idx(j, i): # convierte una coordenada 2D al índice 1D 
        return j * nx + i

    # --- Condiciones de borde ---
    # Paredes: Neumann dp/dxi = 0  
    for i in range(nx):
        r = idx(0, i);    L.rows[r] = [idx(0, i),    idx(1, i)];    L.data[r] = [1.0, -1.0]
        r = idx(ny - 1, i); L.rows[r] = [idx(ny - 1, i), idx(ny - 2, i)]; L.data[r] = [1.0, -1.0]
    # Entrada: Neumann dp/dx = 0 
    for j in range(ny):
        r = idx(j, 0); L.rows[r] = [idx(j, 0), idx(j, 1)]; L.data[r] = [1.0, -1.0]
    # Salida: Dirichlet p = 0  (ancla la presion)
    for j in range(ny):
        r = idx(j, nx - 1); L.rows[r] = [idx(j, nx - 1)]; L.data[r] = [1.0]

    return spla.splu(sp.csc_matrix(L))

# identificamos donde estan los borde. Marca como True todos los nodos de borde 
mascara_borde = np.zeros((ny, nx), dtype=bool)
mascara_borde[0, :] = mascara_borde[-1, :] = True
mascara_borde[:, 0] = mascara_borde[:, -1] = True

# Ejecuta la construcción y factorización una vez, al inicializar, y guarda el objeto LU 
lu_poisson = construir_sistema_poisson(M_x, M_xi, inv_R)

# Resuelve la ecuación de presión a partir de la velocidad intermedia
def resolver_poisson_directo(u_star, v_star, dt, rho, dx, dxi, inv_R, term_corr): 
    du_dx = np.gradient(u_star, dx, axis=1) + term_corr * np.gradient(u_star, dxi, axis=0) # Usamos diferencias centradas con paso dx sobre el eje 1, añadimos el termino correctivo del dominio computacional.
    dv_dy = inv_R * np.gradient(v_star, dxi, axis=0)
    rhs = (rho / dt) * (du_dx + dv_dy)  # Lado derecho de Poisson
    rhs[mascara_borde] = 0.0 # Anula el RHS en los bordes
    p_flat = lu_poisson.solve(rhs.ravel()) #Resuelve  Lp=rhs usando la LU ya factorizada 
    return p_flat.reshape(ny, nx) # Devuelve la presión en forma 2D


# ------------------- Paso de correccion -------------------
def paso_correccion(u_star, v_star, p, dt, rho, dx, dxi, inv_R, term_corr):
    # Calculamos el gradiente de presión con el mismo tratamiento métrico que la divergencia 
    dp_dx = np.gradient(p, dx, axis=1) + term_corr * np.gradient(p, dxi, axis=0)
    dp_dy = inv_R * np.gradient(p, dxi, axis=0)

    u_final = u_star - (dt / rho) * dp_dx
    v_final = v_star - (dt / rho) * dp_dy
    return u_final, v_final




