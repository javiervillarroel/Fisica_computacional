colores = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd']

for idx, (etiqueta, wss_sup) in enumerate(historial_wss_superior.items()):
    ax.plot(x, wss_sup, label=f'{etiqueta}', color=colores[idx % len(colores)], linewidth=2.2)

ax.axvspan(L1, L1 + L2, color='gray', alpha=0.15, label='Zona del Saco Aneurismatico')
