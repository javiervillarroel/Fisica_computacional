# Utilizamos Euler explícito de primer orden

velocidades_prueba = [0.20, 0.30, 0.40, 0.50] # Distintas velocidades maxima de prueba 
t_final = 0.6 # Tiempo final de estudio
intervalo_print = 200 # Cada cuantas iteraciones se imprime el estado

# Parametros del video: solo se usan para el escenario del caudal mayor.
v_max_video = max(velocidades_prueba)   # caso para el que se generara el video
intervalo_frame_video = 100             # cada cuantas iteraciones se captura un frame
fps_video = 20                          # cuadros por segundo del video final

# Acumuladores de WSS para el grafico comparativo final
historial_wss_superior = {}
historial_wss_inferior = {}

for v_max in velocidades_prueba:

    #Calculos fisicos
    v_media = (2.0 / 3.0) * v_max          # perfil parabolico 2D: V_media = (2/3) V_max
    area_seccion = np.pi * (D / 2)**2
    caudal_m3s = v_media * area_seccion     # Q = V_media * Area  [m3/s]
    re_nominal = (rho * v_media * D) / mu_inf # Utilizamos el valor de la viscocidad inf para calcular el numero de Reynolds

    print("\n" + "=" * 64)
    print(f"INICIANDO SIMULACION - CASO: V_max = {v_max} m/s")
    print(f"--> Flow Rate Estimado: {caudal_m3s:.2e} m3/s")
    print(f"--> Reynolds Nominal:   {re_nominal:.0f}")
    print("=" * 64)

    # Inicialización. El fluido esta en reposo.
    u = np.zeros((ny, nx))
    v = np.zeros((ny, nx))
    p = np.zeros((ny, nx))
    u_star = np.zeros((ny, nx))
    t = 0
    iteracion = 0

    # Captura de frames para el video: la lista solo se llena cuando este
    # caso corresponde al caudal mayor. En el resto de los casos queda vacia.
    es_caso_video = np.isclose(v_max, v_max_video)
    frames_video = []

    # Ciclo temporal 
    while t < t_final:
        u_ant, v_ant = u.copy(), v.copy()

        # La velocidad de entrada crece linealmente de 0 a v_max durante los primeros 0.1 s
        v_entrada = v_max * min(1.0, t / 0.1)      # rampa de aceleracion suave
        u[:, 0] = v_entrada * (1 - xi**2) # Perfil parabólico de entrada
        v[:, 0] = 0

        mu = calcular_viscosidad(u_ant, v_ant, inv_R, term_corr, dx, dxi) # Viscosidad local en cada nodo.
        
        # Cantidades para los límites de estabilidad
        u_max_local = max(np.max(np.abs(u_ant)), 1e-4)
        v_max_local = max(np.max(np.abs(v_ant)), 1e-4)
        mu_max = np.max(mu)
        dy_min = np.min((1.0 / inv_R) * dxi) # Tamaño físico de celda más pequeña

        # Como el esquema es explícito, hay dos restricciones
        
        dt_cfl = 1.0 / (u_max_local / dx + v_max_local / dy_min) # CFL advectiva
        
        dt_dif = (rho * (dx * dy_min)**2) / (2.0 * mu_max * (dx**2 + dy_min**2)) # difusiva/viscosa 
        dt = 0.30 * min(dt_cfl, dt_dif)            # factor de seguridad
        dt = min(dt, 0.00005) # techo absoluto 

        u_star, v_star = velocidad_intermedia(u_ant, v_ant, mu, dt, rho, dx, dxi, inv_R, term_corr)
        p = resolver_poisson_directo(u_star, v_star, dt, rho, dx, dxi, inv_R, term_corr)
        u, v = paso_correccion(u_star, v_star, p, dt, rho, dx, dxi, inv_R, term_corr)

        # Filtro compacto Pade selectivo: elimina los modos de longitud 2*dx (no resueltos por la malla)
        # sin tocar los modos fisicamente resueltos.
        u = aplicar_filtro_padre(u)
        v = aplicar_filtro_padre(v)

        # Reaplicamos las condiciones de borde por si la proyeccion las altero 
        u[:, 0] = v_entrada * (1 - xi**2)
        v[:, 0] = 0
        u[0, :], u[-1, :] = 0, 0
        v[0, :], v[-1, :] = 0, 0
        u[:, -1], v[:, -1] = u[:, -2], v[:, -2]

        # Red de seguridad: limita un eventual runaway antes de que sea NaN
        lim = 8.0 * max(v_max, 0.1)
        u = np.clip(u, -lim, lim)
        v = np.clip(v, -lim, lim)

        if np.isnan(u).any() or np.isnan(v).any():
            print(f"  ¡La simulacion exploto en la iteracion {iteracion}!")
            break

        t += dt
        iteracion += 1

        # Captura del estado actual para el video: solo en el caudal mayor y
        # cada 'intervalo_frame_video' iteraciones. Se guardan copias para no aliasar
        # los arreglos del solver; no altera en absoluto la logica de la simulacion.
        if es_caso_video and (iteracion % intervalo_frame_video == 0):
            frames_video.append((t, u.copy(), v.copy()))

        if iteracion % intervalo_print == 0:
            print(f"  it={iteracion:6d} | t={t:.5f}s | dt={dt:.2e} | "
                  f"|u*|max={np.max(np.abs(u_star)):.4f} | "
                  f"p:[{np.min(p):.2e},{np.max(p):.2e}] | "
                  f"|u|max={np.max(np.abs(u)):.4f} | |v|max={np.max(np.abs(v)):.4f}")

    print("  Simulacion del caso completada. Post-procesando (WSS + streamlines + viscosidad)...")

    # -------------------------------------------------------------------------
    # WSS al finalizar t_final para este caudal 
    # -------------------------------------------------------------------------
    du_dxi_final = np.gradient(u, dxi, axis=0)
    du_dy_final = inv_R * du_dxi_final

    wss_inferior = np.abs(mu[0, :] * du_dy_final[0, :])
    wss_superior = np.abs(mu[-1, :] * du_dy_final[-1, :])

    etiqueta = f"Q = {caudal_m3s:.2e} m3/s (Re: {re_nominal:.0f})"
    historial_wss_superior[etiqueta] = wss_superior
    historial_wss_inferior[etiqueta] = wss_inferior


    # -------------------------------------------------------------------------
    # Malla regular para interpolacion 
    # -------------------------------------------------------------------------
    x_lin = np.linspace(0, Lt, 200)
    y_lin = np.linspace(np.min(Y), np.max(Y), 100)
    X_reg, Y_reg = np.meshgrid(x_lin, y_lin) # Armamos las matrices de coordenadas
    puntos = np.column_stack((X.flatten(), Y.flatten()))

    # ----------------------- Lineas de corriente -----------------------
    
    print("  Generando grafico de lineas de corriente...")
    # Interpolamos los valores de velocidad (que están en puntos) sobre la malla regular, con interpolación cúbica
    u_reg = griddata(puntos, u.flatten(), (X_reg, Y_reg), method='cubic', fill_value=0)
    v_reg = griddata(puntos, v.flatten(), (X_reg, Y_reg), method='cubic', fill_value=0)
    velocidad_magnitud = np.sqrt(u_reg**2 + v_reg**2) # Calculamos la magnitud de la velocidad

    fig, ax = plt.subplots(figsize=(13, 5), facecolor='white')
    #  Las líneas de corriente son una curva tangente en todo punto al campo de velocidad; 
    strm = ax.streamplot(X_reg, Y_reg, u_reg, v_reg, color=velocidad_magnitud, cmap='jet',
                         linewidth=1.5, density=3.5, arrowsize=1.2)

    ax.plot(X[0, :], Y[0, :], color='black', linewidth=2.5)
    ax.plot(X[-1, :], Y[-1, :], color='black', linewidth=2.5)

    ax.fill_between(x, R_limite, 0.04, color='white', zorder=10)
    ax.fill_between(x, -R_limite, -0.04, color='white', zorder=10)

    cbar = fig.colorbar(strm.lines, ax=ax, orientation='horizontal', pad=0.15, fraction=0.04)
    cbar.set_label('Magnitud de Velocidad (m/s)', fontsize=11, fontweight='bold')

    ax.axis('off')
    ax.axis('equal')
    ax.set_ylim(-0.035, 0.035)
    """
    titulo = (f"Lineas de Corriente en Aneurisma a t = {t_final:.4f} s\n"
              f"Flow Rate: {caudal_m3s:.2e} m$^3$/s  |  Re: {re_nominal:.0f}  |  V_max: {v_max} m/s")
    plt.title(titulo, fontsize=14, fontweight='bold', pad=15)
    """
    nombre_archivo = f"Streamlines_FlowRate_{caudal_m3s:.2e}_m3s.png"
    plt.savefig(nombre_archivo, dpi=200, bbox_inches='tight')
    plt.close()
    print(f"--> Grafico guardado: {nombre_archivo}")


    # -----------------------  Mapa de viscosidad (Carreau) -----------------------
    # MIismo campo final, misma malla. Recomputa mu_final de (u, v) finales,

    print("  Generando mapa de viscosidad (Carreau)...")

    mu_final = calcular_viscosidad(u, v, inv_R, term_corr, dx, dxi)
    mu_reg = griddata(puntos, mu_final.flatten(), (X_reg, Y_reg), method='cubic')

    fig, ax = plt.subplots(figsize=(13, 5), facecolor='white')

    # Escala fija [mu_inf, mu_0]
    niveles = np.linspace(mu_inf, mu_0, 80)
    cf = ax.contourf(X_reg, Y_reg, mu_reg, levels=niveles, cmap='jet', extend='both')

    ax.plot(X[0, :], Y[0, :], color='black', linewidth=2.5)
    ax.plot(X[-1, :], Y[-1, :], color='black', linewidth=2.5)

    ax.fill_between(x, R_limite, 0.04, color='white', zorder=10)
    ax.fill_between(x, -R_limite, -0.04, color='white', zorder=10)

    cbar = fig.colorbar(cf, ax=ax, orientation='horizontal', pad=0.15, fraction=0.04,
                        ticks=np.linspace(mu_inf, mu_0, 6))
    cbar.ax.set_xticklabels([f"{val:.3f}" for val in np.linspace(mu_inf, mu_0, 6)])
    cbar.set_label('Viscosidad $\\mu$ (Pa$\\cdot$s)', fontsize=11, fontweight='bold')

    ax.axis('off')
    ax.axis('equal')
    ax.set_ylim(-0.035, 0.035)
    nombre_visc = f"Viscosidad_FlowRate_{caudal_m3s:.2e}_m3s.png"
    plt.savefig(nombre_visc, dpi=200, bbox_inches='tight')
    plt.close()
    print(f"--> Grafico guardado: {nombre_visc}\n")


    # -----------------------  Video de la simulacion -----------------------
    if es_caso_video:
        generar_video_simulacion(frames_video, caudal_m3s, re_nominal, v_max,
                                 X, Y, R_limite, x, fps_video=fps_video)


