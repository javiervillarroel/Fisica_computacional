import matplotlib.animation as animation
from matplotlib.cm import ScalarMappable
from matplotlib.colors import Normalize

def generar_video_simulacion(frames_video, caudal_m3s, re_nominal, v_max,
                             X, Y, R_limite, x, fps_video=20):
    # frames_video: lista de tuplas (t, u, v) capturadas durante el ciclo temporal
    # del caso de caudal mayor. Cada tupla es un instante de la simulacion.
    if len(frames_video) == 0:
        print("  No hay frames capturados: no se genera video.")
        return

    print(f"\n  Renderizando video de la simulacion ({len(frames_video)} frames)...")

    # Malla regular para interpolar cada frame. Algo mas ligera que la del post-proceso
    # para acelerar el render sin perder calidad visual apreciable.
    x_lin_v = np.linspace(0, Lt, 160)
    y_lin_v = np.linspace(np.min(Y), np.max(Y), 80)
    X_reg_v, Y_reg_v = np.meshgrid(x_lin_v, y_lin_v)
    puntos_v = np.column_stack((X.flatten(), Y.flatten()))

    # Escala de color FIJA para todo el video (0 .. v_max) -> los instantes son comparables
    niveles_v = np.linspace(0, v_max, 60)
    norma_v = Normalize(vmin=0, vmax=v_max)

    fig, ax = plt.subplots(figsize=(13, 5), facecolor='white')

    # Barra de color creada una sola vez (independiente del contourf de cada frame)
    sm = ScalarMappable(norm=norma_v, cmap='jet')
    sm.set_array([])
    cbar = fig.colorbar(sm, ax=ax, orientation='horizontal', pad=0.12, fraction=0.04)
    cbar.set_label('Magnitud de Velocidad (m/s)', fontsize=11, fontweight='bold')

    def dibujar_frame(k):
        # Redibuja por completo el eje principal en cada instante k
        ax.clear()
        t_k, u_k, v_k = frames_video[k]

        # Interpolamos el campo de velocidad del instante a la malla regular
        u_reg = griddata(puntos_v, u_k.flatten(), (X_reg_v, Y_reg_v), method='linear', fill_value=0)
        v_reg = griddata(puntos_v, v_k.flatten(), (X_reg_v, Y_reg_v), method='linear', fill_value=0)
        mag = np.sqrt(u_reg**2 + v_reg**2)

        # Campo de magnitud + lineas de corriente del instante
        ax.contourf(X_reg_v, Y_reg_v, mag, levels=niveles_v, cmap='jet', extend='max')
        ax.streamplot(X_reg_v, Y_reg_v, u_reg, v_reg, color='black',
                      linewidth=0.6, density=2.0, arrowsize=0.7)

        # Paredes de la arteria y enmascarado exterior (igual que en el post-proceso)
        ax.plot(X[0, :], Y[0, :], color='black', linewidth=2.5)
        ax.plot(X[-1, :], Y[-1, :], color='black', linewidth=2.5)
        ax.fill_between(x, R_limite, 0.04, color='white', zorder=10)
        ax.fill_between(x, -R_limite, -0.04, color='white', zorder=10)

        ax.axis('off')
        ax.set_xlim(0, Lt)
        ax.set_ylim(-0.035, 0.035)
        ax.set_aspect('equal')
        ax.set_title(f"Evolucion del flujo en el aneurisma  |  t = {t_k:.4f} s   "
                     f"(Q = {caudal_m3s:.2e} m3/s,  Re = {re_nominal:.0f})",
                     fontsize=12, fontweight='bold')
        return []

    anim = animation.FuncAnimation(fig, dibujar_frame, frames=len(frames_video), blit=False)

    # Guardado: se intenta MP4 (ffmpeg) y, si no esta disponible, se cae a GIF (Pillow)
    nombre_video = f"Simulacion_Video_FlowRate_{caudal_m3s:.2e}_m3s.mp4"
    try:
        writer = animation.FFMpegWriter(fps=fps_video, bitrate=3000)
        anim.save(nombre_video, writer=writer, dpi=130)
        print(f"--> Video guardado: {nombre_video}")
    except Exception as e:
        print(f"  ffmpeg no disponible ({e}). Generando GIF con Pillow...")
        nombre_video = f"Simulacion_Video_FlowRate_{caudal_m3s:.2e}_m3s.gif"
        try:
            writer = animation.PillowWriter(fps=fps_video)
            anim.save(nombre_video, writer=writer, dpi=110)
            print(f"--> Video (GIF) guardado: {nombre_video}")
        except Exception as e2:
            print(f"  No se pudo guardar el video: {e2}")

    plt.close(fig)


