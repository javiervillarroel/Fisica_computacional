import numpy as np
from scipy.integrate import solve_ivp
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestRegressor
from sklearn.neural_network import MLPRegressor
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_squared_error, r2_score

print("Importaciones listas. Iniciando script...")

np.random.seed(42)

# ============================================================
# Oscilador armónico amortiguado
# ============================================================

def modelo(t, y, m, gamma, k): 
    # Definimos el modelo del oscilador armonico amortiguado
    y1, y2 = y
    dy1_dt = y2                          # dx/dt = v
    dy2_dt = -(k/m)*y1 - (gamma/m)*y2   # dv/dt = -(k/m)x - (gamma/m)v
    return [dy1_dt, dy2_dt]

# ============================================================
# Parte (b): 
# ============================================================

def generar_datos(N=3000, sigma=0.02, t_eval=None):
    if t_eval is None:
        t_eval = np.linspace(0, 10, 1000) # Generamos los 1000 puntos
    
    Nt = len(t_eval)
    señales = np.zeros((N, Nt))
    parametros = np.zeros((N, 2))

    for i in range(N):
        #if i % 500 == 0 and i > 0:
        #    print(f"  ... simuladas {i}/{N} señales")

        gamma = np.random.uniform(0.05, 1.0) # Generamos Gamma
        k = np.random.uniform(1.0, 5.0)      # Generamos k
        
        # Solución numérica mediante de la EDO
        sol = solve_ivp(modelo, (0, 10), [1.0, 0.0], t_eval=t_eval, args=(1.0, gamma, k))
        x_t = sol.y[0] # Guardamos la solución
        
        # Agregamos ruido gaussiano independiente
        ruido = np.random.normal(0, sigma, Nt) # Generamos la distribución gaussiana
        señales[i] = x_t + ruido # Sumamos el ruido a la solución para la señal i
        parametros[i] = [gamma, k] # Guardamos los parametros gamma y k para la señal i

    return señales, parametros

t_eval = np.linspace(0, 10, 1000)

# --- Generar datos con sigma = 0.02 ---
print("=" * 60)
print("PARTE (b): Generación de datos")
print("=" * 60)
print("Generando N = 3000 señales con σ = 0.02 mediante solve_ivp...")
