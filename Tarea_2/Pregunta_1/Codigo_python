ax.set_xlabel('σ (nivel de ruido)', fontsize=12)
ax.set_ylabel('RMSE_k', fontsize=12)
ax.set_title('RMSE de la constante elástica k vs nivel de ruido')
ax.legend()
ax.grid(True, alpha=0.3)

plt.suptitle('Parte (d): Efecto del ruido en la inferencia',
             fontweight='bold', fontsize=14)
