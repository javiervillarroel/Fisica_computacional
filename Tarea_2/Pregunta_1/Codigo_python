print("Generación completada.")
print(f"  Shape señales:    {señales.shape}")
print(f"  Shape parámetros: {parametros.shape}")
print(f"  γ ∈ [{parametros[:,0].min():.3f}, {parametros[:,0].max():.3f}]")
print(f"  k ∈ [{parametros[:,1].min():.3f}, {parametros[:,1].max():.3f}]")
print()



# --- Gráficos de señales de ejemplo ---
print("Generando gráficos...")
fig, axes = plt.subplots(2, 2, figsize=(14, 8))

# Efecto de variar k con gamma fijo: muestra cómo cambia la frecuencia
ax = axes[0, 0]
gamma_fijo = 0.3
for k_val in [1.0, 2.0, 3.5, 5.0]:
    sol = solve_ivp(modelo, (0, 10), [1.0, 0.0], t_eval=t_eval, args=(1.0, gamma_fijo, k_val))
    ax.plot(t_eval, sol.y[0], linewidth=1.5, label=f'k = {k_val}')
ax.set_xlabel('t')
ax.set_ylabel('x(t)')
ax.set_title(f'Efecto de k (γ = {gamma_fijo} fijo)')
ax.legend()
ax.grid(True, alpha=0.3)

# Efecto de variar gamma con k fijo: muestra cómo cambia el decaimiento
ax = axes[0, 1]
k_fijo = 3.0
for gamma_val in [0.05, 0.2, 0.5, 1.0]:
    sol = solve_ivp(modelo, (0, 10), [1.0, 0.0], t_eval=t_eval, args=(1.0, gamma_val, k_fijo))
    ax.plot(t_eval, sol.y[0], linewidth=1.5, label=f'γ = {gamma_val}')
ax.set_xlabel('t')
ax.set_ylabel('x(t)')
ax.set_title(f'Efecto de γ (k = {k_fijo} fijo)')
ax.legend()
ax.grid(True, alpha=0.3)

# Señales del dataset con ruido — k bajos (frecuencia baja)
ax = axes[1, 0]
idx_low_k = np.argsort(parametros[:, 1])[:4]
for idx in idx_low_k:
    g, k = parametros[idx]
    ax.plot(t_eval, señales[idx], alpha=0.8, label=f'γ={g:.2f}, k={k:.2f}')
ax.set_xlabel('t')
ax.set_ylabel(r'$x_{obs}(t)$')
ax.set_title('Señales con ruido (k bajos)')
ax.legend(fontsize=8)
ax.grid(True, alpha=0.3)

# Señales del dataset con ruido — k altos (frecuencia alta)
ax = axes[1, 1]
idx_high_k = np.argsort(parametros[:, 1])[-4:]
for idx in idx_high_k:
    g, k = parametros[idx]
    ax.plot(t_eval, señales[idx], alpha=0.8, label=f'γ={g:.2f}, k={k:.2f}')
ax.set_xlabel('t')
ax.set_ylabel(r'$x_{obs}(t)$')
ax.set_title('Señales con ruido (k altos)')
ax.legend(fontsize=8)
ax.grid(True, alpha=0.3)

plt.suptitle('Parte (b): Señales del oscilador amortiguado',
             fontweight='bold', fontsize=14)
plt.tight_layout()



# ============================================================
# Parte (c):
# ============================================================
print("=" * 60)
print("PARTE (c): Entrenamiento de modelos")
print("=" * 60)

# --- Separamos los datos ---
X_train, X_test, y_train, y_test = train_test_split(señales, parametros, test_size=0.2, random_state=42)
print(f"  Train: {X_train.shape[0]} señales")
print(f"  Test:  {X_test.shape[0]} señales")
#print(" 1. Separación de datos lista.\n")


# ---- Modelo 1: RandomForestRegressor ----
print("Configurando RandomForestRegressor...")
rf_model = RandomForestRegressor(
    n_estimators=200,        # 200 árboles de decisión (ensemble)
    max_depth=20,            # Profundidad máxima de cada árbol
    min_samples_leaf=5,      # Mínimo de muestras por hoja
    random_state=42,         # Semilla
    n_jobs=-1                # Paralelización en todos los cores
)

rf_model.fit(X_train, y_train)

y_pred_rf = rf_model.predict(X_test)
print(" Predicción de Random Forest lista.\n")

# Cálculo de métricas para Random Forest
rmse_gamma_rf = np.sqrt(mean_squared_error(y_test[:, 0], y_pred_rf[:, 0]))
rmse_k_rf     = np.sqrt(mean_squared_error(y_test[:, 1], y_pred_rf[:, 1]))
r2_gamma_rf   = r2_score(y_test[:, 0], y_pred_rf[:, 0])
r2_k_rf       = r2_score(y_test[:, 1], y_pred_rf[:, 1])


# ---- Modelo 2: MLPRegressor (red neuronal) ----
scaler_X = StandardScaler()
scaler_y = StandardScaler()
X_train_s = scaler_X.fit_transform(X_train)   # Normalizamos el entrenamiento
X_test_s  = scaler_X.transform(X_test)        
y_train_s = scaler_y.fit_transform(y_train)

print("Configurando MLPRegressor...")
mlp_model = MLPRegressor(
    hidden_layer_sizes=(128, 64, 32),   # 3 capas ocultas 
    activation='relu',                  # ReLU: max(0, x) — introduce no linealidad
    solver='adam',                      # Optimizador Adam — convergencia eficiente
    alpha=1e-4,                         # Regularización L2 — controla sobreajuste
    batch_size=32,                      # Mini-batch de 32 ejemplos
    learning_rate_init=1e-3,            # Tasa de aprendizaje inicial
    max_iter=500,                       # Máximo de épocas de entrenamiento
    early_stopping=True,                # Detener cuando validación no mejora
    validation_fraction=0.1,            # 10% del train para validación interna
    random_state=42                     # Semilla
)

mlp_model.fit(X_train_s, y_train_s)
print("ENTRENAMIENTO de MLP TERMINADO.")

# Des-normalizar predicciones para volver a las unidades originales de gamma y k
y_pred_mlp_s = mlp_model.predict(X_test_s)
y_pred_mlp   = scaler_y.inverse_transform(y_pred_mlp_s)
print("Predicción de MLP lista.\n")

# Cálculo de métricas para MLP
rmse_gamma_mlp = np.sqrt(mean_squared_error(y_test[:, 0], y_pred_mlp[:, 0]))
rmse_k_mlp     = np.sqrt(mean_squared_error(y_test[:, 1], y_pred_mlp[:, 1]))
r2_gamma_mlp   = r2_score(y_test[:, 0], y_pred_mlp[:, 0])
r2_k_mlp       = r2_score(y_test[:, 1], y_pred_mlp[:, 1])


# ---- Tabla comparativa ----
print("Resumen de desempeño (σ = 0.02):")
print(f"{'Modelo':<25} {'RMSE_γ':>10} {'RMSE_k':>10} {'R²_γ':>10} {'R²_k':>10}")
print("-" * 65)
print(f"{'RandomForest':<25} {rmse_gamma_rf:>10.5f} {rmse_k_rf:>10.5f} {r2_gamma_rf:>10.4f} {r2_k_rf:>10.4f}")
print(f"{'MLPRegressor':<25} {rmse_gamma_mlp:>10.5f} {rmse_k_mlp:>10.5f} {r2_gamma_mlp:>10.4f} {r2_k_mlp:>10.4f}")
print()


# ---- Gráficos: predicho vs real ----
print(" Generando Gráficos (Predicho vs Real)...")
fig, axes = plt.subplots(2, 2, figsize=(14, 10))
param_labels = ['γ (amortiguamiento)', 'k (constante elástica)']

for col, (nombre, y_pred) in enumerate([
    ('Random Forest', y_pred_rf),
    ('MLP Regressor', y_pred_mlp)
]):
    for row, label in enumerate(param_labels):
        ax = axes[row, col]
        color = '#4CAF50' if col == 0 else '#2196F3'
        ax.scatter(y_test[:, row], y_pred[:, row], s=10, alpha=0.4, c=color)
        lims = [y_test[:, row].min(), y_test[:, row].max()]
        ax.plot(lims, lims, 'r--', linewidth=2, label='Predicción perfecta')
        rmse = np.sqrt(mean_squared_error(y_test[:, row], y_pred[:, row]))
        r2 = r2_score(y_test[:, row], y_pred[:, row])
        ax.set_xlabel(f'{label} (real)')
        ax.set_ylabel(f'{label} (predicho)')
        ax.set_title(f'{nombre} — {label}\nRMSE = {rmse:.4f}, R² = {r2:.4f}')
        ax.legend()
        ax.grid(True, alpha=0.3)

plt.suptitle('Parte (c):  Desempeño de cada modelo', fontweight='bold', fontsize=14)
plt.tight_layout()

# ---- Curva de pérdida del MLP ----
fig, ax = plt.subplots(figsize=(8, 5))
ax.plot(mlp_model.loss_curve_, color='#2196F3', linewidth=2,
        label='Pérdida de entrenamiento')
ax.set_xlabel('Época')
ax.set_ylabel('Pérdida (MSE normalizado)')
ax.set_title('Curva de entrenamiento del MLPRegressor')
ax.legend()
ax.grid(True, alpha=0.3)
plt.tight_layout()
#plt.show()
print("Fin del script de la parte (c).")






# ============================================================
# Parte (d): Estudio del efecto del ruido
# ============================================================
print("=" * 60)
print("PARTE (d): Efecto del nivel de ruido σ")
print("=" * 60)

sigmas = [0.0, 0.01, 0.02, 0.05, 0.10]

# Diccionario para almacenar todos los RMSE (train y test)
resultados = {key: [] for key in [
    'RF_RMSE_gamma', 'RF_RMSE_k',
    'RF_RMSE_gamma_train', 'RF_RMSE_k_train',
    'MLP_RMSE_gamma', 'MLP_RMSE_k',
    'MLP_RMSE_gamma_train', 'MLP_RMSE_k_train',
]}

for sigma in sigmas:
    print(f"\n  σ = {sigma:.2f} — Generando datos y entrenando...")

    # Generar nuevo dataset con este nivel de ruido
    señales_s, parametros_s = generar_datos(N=3000, sigma=sigma, t_eval=t_eval)

    # Split 80/20
    Xtr, Xte, ytr, yte = train_test_split(
        señales_s, parametros_s, test_size=0.2, random_state=42
    )

    # --- Random Forest ---
    rf = RandomForestRegressor(
        n_estimators=100, max_depth=20, min_samples_leaf=5,
        random_state=42, n_jobs=-1
    )
    rf.fit(Xtr, ytr)
    yp_rf_test  = rf.predict(Xte)
    yp_rf_train = rf.predict(Xtr)

    resultados['RF_RMSE_gamma'].append(
        np.sqrt(mean_squared_error(yte[:, 0], yp_rf_test[:, 0])))
    resultados['RF_RMSE_k'].append(
        np.sqrt(mean_squared_error(yte[:, 1], yp_rf_test[:, 1])))
    resultados['RF_RMSE_gamma_train'].append(
        np.sqrt(mean_squared_error(ytr[:, 0], yp_rf_train[:, 0])))
    resultados['RF_RMSE_k_train'].append(
        np.sqrt(mean_squared_error(ytr[:, 1], yp_rf_train[:, 1])))

    # --- MLP ---
    sc_X = StandardScaler()
    sc_y = StandardScaler()
    Xtr_s = sc_X.fit_transform(Xtr)
    Xte_s = sc_X.transform(Xte)
    ytr_s = sc_y.fit_transform(ytr)

    mlp = MLPRegressor(
        hidden_layer_sizes=(128, 64, 32),
        activation='relu', solver='adam',
        alpha=1e-4, batch_size=32, learning_rate_init=1e-3,
        max_iter=500, early_stopping=True, validation_fraction=0.1,
        random_state=42, verbose=False
    )
    mlp.fit(Xtr_s, ytr_s)
    yp_mlp_test  = sc_y.inverse_transform(mlp.predict(Xte_s))
    yp_mlp_train = sc_y.inverse_transform(mlp.predict(Xtr_s))

    resultados['MLP_RMSE_gamma'].append(
        np.sqrt(mean_squared_error(yte[:, 0], yp_mlp_test[:, 0])))
    resultados['MLP_RMSE_k'].append(
        np.sqrt(mean_squared_error(yte[:, 1], yp_mlp_test[:, 1])))
    resultados['MLP_RMSE_gamma_train'].append(
        np.sqrt(mean_squared_error(ytr[:, 0], yp_mlp_train[:, 0])))
    resultados['MLP_RMSE_k_train'].append(
        np.sqrt(mean_squared_error(ytr[:, 1], yp_mlp_train[:, 1])))

    # Reporte por sigma
    print(f"    RF  — RMSE_γ(train)={resultados['RF_RMSE_gamma_train'][-1]:.5f}, "
          f"RMSE_γ(test)={resultados['RF_RMSE_gamma'][-1]:.5f}")
    print(f"         RMSE_k(train)={resultados['RF_RMSE_k_train'][-1]:.5f}, "
          f"RMSE_k(test)={resultados['RF_RMSE_k'][-1]:.5f}")
    print(f"    MLP — RMSE_γ(train)={resultados['MLP_RMSE_gamma_train'][-1]:.5f}, "
          f"RMSE_γ(test)={resultados['MLP_RMSE_gamma'][-1]:.5f}")
    print(f"         RMSE_k(train)={resultados['MLP_RMSE_k_train'][-1]:.5f}, "
          f"RMSE_k(test)={resultados['MLP_RMSE_k'][-1]:.5f}")


